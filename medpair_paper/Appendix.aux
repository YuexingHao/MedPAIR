\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Sentence Position Analysis.} Plot (a) Distribution of physician trainees’ majority‐vote relevance labels by sentence position. Plot (b) Distribution of GPT-4o self-reported relevance labels by sentence position. Plot (c) ContextCite scores across the context for three open-source models (Qwen-14B, Llama-70B, Qwen-72B).}}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:sentence_position}{{2}{2}{\textbf {Sentence Position Analysis.} Plot (a) Distribution of physician trainees’ majority‐vote relevance labels by sentence position. Plot (b) Distribution of GPT-4o self-reported relevance labels by sentence position. Plot (c) ContextCite scores across the context for three open-source models (Qwen-14B, Llama-70B, Qwen-72B)}{figure.caption.3}{}}
\citation{zhang2024min}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {MedPAIR Dataset Curation.} We curated a 933 annotated QA dataset MedPAIR. Data are structured into patient profile and query components. In the first step, 52 physician trainees and 6 LLMs independently select the most appropriate answer. In the second step, physician trainees annotate the relevance of each sentence within the patient profile, excluding annotations link to incorrect answers. Majority voting is used to produce binary relevance labels for physician trainees. Concurrently, we prompt close-source LLMs (GPT-4o, GPT-5) to follow the physician annotation instructions and employ ContextCite with open-source LLMs (Qwen-14B, Qwen-72B, Llama-70B, MedGemma-27B) to generate both relevance scores and self-reported labels.}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{Self_Report_Vs_Centaur_Lab}{{3}{3}{\textbf {MedPAIR Dataset Curation.} We curated a 933 annotated QA dataset MedPAIR. Data are structured into patient profile and query components. In the first step, 52 physician trainees and 6 LLMs independently select the most appropriate answer. In the second step, physician trainees annotate the relevance of each sentence within the patient profile, excluding annotations link to incorrect answers. Majority voting is used to produce binary relevance labels for physician trainees. Concurrently, we prompt close-source LLMs (GPT-4o, GPT-5) to follow the physician annotation instructions and employ ContextCite with open-source LLMs (Qwen-14B, Qwen-72B, Llama-70B, MedGemma-27B) to generate both relevance scores and self-reported labels}{figure.caption.4}{}}
