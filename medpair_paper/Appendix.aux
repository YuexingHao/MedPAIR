\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Model Memorization Metrics across Different Datasets}. All resulting scores are negative. Values that are less negative (i.e., closer to 0) indicate that the model considers the text more predictable, which provides a stronger indication that the text appeared in its training data. Values presented as mean ± standard deviation.}}{4}{table.caption.5}\protected@file@percent }
\newlabel{model_memorization}{{2}{4}{\textbf {Model Memorization Metrics across Different Datasets}. All resulting scores are negative. Values that are less negative (i.e., closer to 0) indicate that the model considers the text more predictable, which provides a stronger indication that the text appeared in its training data. Values presented as mean ± standard deviation}{table.caption.5}{}}
